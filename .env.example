# PostgreSQL (Railway)
DATABASE_URL=postgresql://user:password@host:5432/railway

# Pool de conexiones SQLAlchemy (opcional, valores por defecto conservadores).
# pool_size + max_overflow, multiplicado por el número de workers de Uvicorn,
# no debe superar el límite de conexiones del plan de Postgres en Railway.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_TIMEOUT_SECONDS=30
# DB_POOL_RECYCLE_SECONDS=1800

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# JWT
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# CORS (orígenes separados por coma, sin espacios extra)
# Local + producción:
# CORS_ORIGINS=http://localhost:4200,https://guayabita.vercel.app
CORS_ORIGINS=http://localhost:4200,https://guayabita.vercel.app

# Game defaults
INITIAL_BALANCE=5000

# --- Resend (correos transaccionales) ---
# 1. Crear cuenta en https://resend.com
# 2. API key: https://resend.com/api-keys
# 3. Dev: usar onboarding@resend.dev (solo envía al correo dueño de la cuenta)
# 4. Prod: verificar dominio en https://resend.com/domains y usar noreply@tudominio.com
RESEND_API_KEY=re_your_api_key_here

# Remitente visible en los correos
# Dev:
EMAIL_FROM=Guayabita <onboarding@resend.dev>
# Prod (descomentar cuando el dominio esté verificado):
# EMAIL_FROM=Guayabita <noreply@tudominio.com>

# URL pública del frontend Angular (Vercel en prod). Los links de correo apuntan aquí.
FRONTEND_URL=http://localhost:4200
# Prod:
# FRONTEND_URL=https://guayabita.vercel.app

# Correo del administrador para notificaciones de compras nuevas y solicitudes
# de soporte. Si se deja vacío, esas notificaciones simplemente no se envían
# (no rompe el flujo de compra ni de soporte).
ADMIN_NOTIFICATION_EMAIL=

# TTL de tokens en Redis
EMAIL_VERIFY_TOKEN_TTL_HOURS=48
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# --- Cloudflare R2 (fotos de perfil) ---
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=guayabita
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://your-public-r2-domain.example

# Avatar por defecto (ruta local del frontend Angular)
DEFAULT_AVATAR_URL=/images/avatar-default.png

# Usuario que será promovido a administrador al iniciar el backend (opcional)
INITIAL_ADMIN_USERNAME=lordComando

# Modo mantenimiento — bloquea APIs excepto /status y webhooks de Wompi
MAINTENANCE_MODE=false
# MAINTENANCE_MESSAGE=Estamos preparando algo especial. ¡Vuelve pronto!

# --- Wompi (pasarela de pagos) ---
# Sandbox: https://sandbox.wompi.co/v1 | Producción: https://production.wompi.co/v1
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_...
WOMPI_PRIVATE_KEY=prv_test_...
WOMPI_INTEGRITY_SECRET=test_integrity_...
WOMPI_EVENTS_SECRET=test_events_...
WOMPI_REDIRECT_URL=https://guayabita.vercel.app/recargar/resultado

# URL del webhook SOLO para eventos POST de Wompi (panel → Eventos → sandbox).
# NO uses esta URL como redirect del usuario; PSE redirige por GET y fallaría.
WOMPI_WEBHOOK_URL=https://guayabita-backend-production.up.railway.app/payments/wompi/webhook

# --- Meta API de Conversiones (CompleteRegistration y Purchase por el servidor) ---
# Recupera eventos que el navegador pierde por bloqueadores de anuncios o iOS.
# Si se dejan vacías, simplemente no se envía nada — el pixel del navegador
# sigue funcionando igual, esto es un complemento, no un reemplazo.
# Pixel ID: Events Manager → guayabita_pixel → Configuración → "Identificador
# del conjunto de datos" (el mismo que ya usa el frontend en environment.prod.ts).
META_PIXEL_ID=
# Token: Events Manager → guayabita_pixel → Configuración → API de
# Conversiones → "Configurar integración directa" → generar token.
META_CAPI_ACCESS_TOKEN=
# Opcional, solo mientras se valida en Meta → pestaña "Probar eventos" (ahí
# aparece el código, algo como TEST12711). Quitar antes de lanzar la pauta:
# con esto puesto, los eventos NO cuentan para la pauta real.
META_CAPI_TEST_EVENT_CODE=

# --- TikTok API de Eventos (CompleteRegistration y CompletePayment por el servidor) ---
# Mismo criterio que la API de Conversiones de Meta de arriba: recupera eventos
# que el navegador pierde, es un complemento, no un reemplazo del pixel.
# Pixel ID: TikTok Events Manager → guayabita_tiktok_pixel → "ID del píxel"
# (el mismo que ya usa el frontend en environment.prod.ts).
TIKTOK_PIXEL_ID=
# Token: TikTok Events Manager → guayabita_tiktok_pixel → Implementar la API
# de eventos → "Generar token de acceso".
TIKTOK_CAPI_ACCESS_TOKEN=
# Opcional, solo mientras se valida en TikTok → Test Events. Quitar antes de
# lanzar la pauta real: con esto puesto, los eventos NO cuentan para la pauta.
TIKTOK_CAPI_TEST_EVENT_CODE=
